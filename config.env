# TP Classroom build settings — used by the scripts in ./scripts
# One version number for everything: the Mac teacher, the Mac student and Windows (teacher + student).
# Raise it every time you release an update (1.0.0 → 1.0.1 → 1.1.0 …).
APP_VERSION="1.0.4"

# Bundle IDs become <prefix>.teacher and <prefix>.student
BUNDLE_ID_PREFIX="com.tpclassroom"

# Your public GitHub repo for updates (made for you: github.com/kornchapattonpoon/tp-classroom-updates).
GITHUB_REPO="kornchapattonpoon/tp-classroom-updates"

# Where teacher apps look for new versions. With GitHub Releases this always points at the newest release.
UPDATE_FEED_URL="https://github.com/${GITHUB_REPO}/releases/latest/download/appcast.json"

# Where the update files for this version are uploaded.
ASSET_BASE_URL="https://github.com/${GITHUB_REPO}/releases/download/v${APP_VERSION}"

# Filled in by ./scripts/setup-keys.sh — apps only install updates signed by your private key.
UPDATE_PUBLIC_KEY="MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEWm5nJXvCI9zVOwdyvtYD1N17GUgVlEeruKjfurpAFrpoeODVst3BQftkJHdzoHc2pMl0t9vNco8QRvmsYKfIzQ=="

# Mac code signing. "-" = ad-hoc. Strongly recommended: make a free self-signed
# "Code Signing" certificate in Keychain Access and put its name here (see README),
# so macOS keeps the Screen Recording/Accessibility permissions after each update.
SIGN_IDENTITY="-"

# Build the Mac apps for Apple Silicon and Intel iMacs.
ARCHS="arm64 x86_64"

# Build the Windows app too (the .NET 10 SDK is downloaded into ~/.dotnet automatically, no admin needed).
# auto = build it if dotnet is installed, yes = must build, no = skip.
BUILD_WINDOWS="auto"

# TP AI (the assistant in the teacher app). Works with any OpenAI-compatible service; Groq by default.
# AI_API_KEY is built into the teacher apps (stored scrambled), so TP AI works for every teacher with no setup,
# like TP Browser. Never write the key in this file on GitHub: GitHub's build gets it from the AI_API_KEY
# secret (Settings → Secrets and variables → Actions). Note: the apps are public and the Windows exe is also
# on student PCs, so a determined person could still dig the key out. If that happens, make a new key at
# console.groq.com and replace the secret, then publish an update.
AI_API_KEY="${AI_API_KEY:-}"
AI_MODEL="qwen/qwen3.8-27b"
AI_BASE_URL="https://api.groq.com/openai/v1"
